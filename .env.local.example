# ─── Supabase ─────────────────────────────────────────────────────────────────
# Project Settings → API. The anon key is public by design (it is shipped in the
# client bundle); RLS is what protects the data, not the key.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only. Bypasses RLS entirely — never expose it to the browser. Used by
# the admin routes and anything writing app_metadata (see src/lib/authz.ts).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Base URL for OAuth redirects and Open Graph metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: NEXT_PUBLIC_APP_URL=https://metricforge.app

# ─── Windsor.ai — the data source ─────────────────────────────────────────────
# Every connector reads through Windsor. The shared workspace key is only ever
# used together with a user's own connected-account scope
# (app_metadata.windsor_accounts[<ds>]) — without that scope a user would see
# the entire shared workspace, so the routes refuse to use it unscoped.
# Users may also supply their own personal key from the Profile page.
WINDSOR_API_KEY=

# ─── Gemini (Vertex AI) ───────────────────────────────────────────────────────
# Two transports, tried in this order by src/lib/gemini.ts:
#
#   1. GEMINI_API_KEY            AI Studio. Simplest for local development.
#   2. Workload identity federation. What production uses — no key exists
#      anywhere. Vercel mints an OIDC token per request, Google STS exchanges it,
#      and that impersonates the service account. The GCP org enforces
#      iam.disableServiceAccountKeyCreation, so a downloaded key is not an option.
#
# GEMINI_API_KEY=AIza...
GCP_WORKLOAD_IDENTITY_PROVIDER=projects/<number>/locations/global/workloadIdentityPools/vercel/providers/vercel-oidc
GCP_SERVICE_ACCOUNT_EMAIL=metricforge-gemini@<project>.iam.gserviceaccount.com
# VERCEL_OIDC_TOKEN is injected by Vercel at runtime — do not set it by hand.
# Locally, `vercel env pull` writes one, or use GEMINI_API_KEY instead.
GEMINI_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
# Only needed if the project cannot be derived from GCP_SERVICE_ACCOUNT_EMAIL.
# GEMINI_PROJECT_ID=

# Optional fallback LLM, used when Gemini is unavailable.
# GROQ_API_KEY=

# ─── Cron ─────────────────────────────────────────────────────────────────────
# Shared secret for /api/ai-optimizer/refresh, called by vercel.json's cron and
# by .github/workflows/optimizer-refresh.yml.
CRON_SECRET=

# ─── Removed ──────────────────────────────────────────────────────────────────
# BQ_*, GOOGLE_CLIENT_ID/SECRET, GOOGLE_ADS_DEVELOPER_TOKEN and PREFER_BIGQUERY
# are gone. The BigQuery source was deleted — it had never worked and no UI
# reached it. See docs/bigquery-disabled.md, and scripts/restore-bigquery.sh if
# you ever need it back.
