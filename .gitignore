# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …but the placeholder template IS committed, so a fresh clone knows what to set.
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python
__pycache__/
*.pyc

# Local dev scratch artifacts
scratch/

# Figma inspection temp artifacts
.fig/
.git-rewrite

# Assets pulled from Figma by the MCP server — reference material, not source.
design/figma/

# Original-project internal notes / agent instructions — kept local, not published
/AGENTS.md
/CLAUDE.md
/docs/
/.claude/
